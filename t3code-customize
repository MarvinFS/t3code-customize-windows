class Stop(Exception):
    """A clean stop with a message for the user."""


class NeedsFix(Stop):
    """The patches need porting to this upstream commit (conflict or failing check)."""


class NotNightly(Stop):
    """The installed T3 Code is not on the Nightly line the patches target."""


def say(message=''):
    print(message, flush=True)


def step(message):
    say('==> ' + message)


def resolve(args, env=None):
    if WIN:
        # CreateProcess does not resolve .cmd shims (pnpm, vp, tsc-rs) by bare name, and npm leaves an
        # extensionless shell script next to each, which which() would return first.
        search = (env or os.environ).get('PATH')
        args = [next((found for suffix in ('.exe', '.cmd', '') if (found := shutil.which(str(args[0]) + suffix, path=search))),
                     args[0]), *args[1:]]
    return args


def run(args, cwd=None, env=None, log=None, check=True, capture=False):
    args = resolve(args, env)
    result = subprocess.run(args, cwd=cwd, env=env, text=capture,
                            stdout=subprocess.PIPE if capture else log,
                            stderr=log if not capture else None,
                            **({'encoding': 'utf-8'} if capture else {}))
    if check and result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {" ".join(map(str, args))}' + (f'\nLog: {log.name}' if log else ''))
    return result.stdout if capture else result


def git(*args, check=True, capture=True, log=None):
    env = {**os.environ, **GIT_ENV}
    # No CRLF conversion: the patches and the build must see upstream's bytes.
    return run(['git', '-c', 'core.hooksPath=' + os.devnull, '-c', 'core.autocrlf=false', '-c', 'core.longpaths=true', *args],
               cwd=SOURCE, env=env, check=check, capture=capture, log=log)


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def load(path, default=None):
    return json.loads(path.read_text(encoding='utf-8')) if path.exists() else default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2) + '\n', encoding='utf-8', newline='\n')
    os.replace(temporary, path)


def patches():
    return sorted((REPO / 'patches').glob('*.patch'))


def recipe_hash():
    digest = hashlib.sha256()
    for path in patches() + [REPO / 'patches/base.txt', REPO / 'checks.json']:
        digest.update(path.name.encode() + path.read_bytes())
    return digest.hexdigest()[:12]


def interactive():
    # pythonw (the scheduled task) has no stdin or stdout at all
    return bool(sys.stdin and sys.stdout and sys.stdin.isatty() and sys.stdout.isatty())


def extract_tar(archive, destination):
    with tarfile.open(archive) as bundle:
        if hasattr(tarfile, 'data_filter'):
            bundle.extractall(destination, filter='data')
        else:
            bundle.extractall(destination)


# --- Finding the installed AppImage -------------------------------------------------

def version_key(path):
    return [int(part) if part.isdigit() else part for part in re.split(r'(\d+)', path.name)]


def find_appimage(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not path.is_file():
            raise Stop(f'No AppImage at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured:
        path = Path(configured)
        if path.is_file():
            return path.resolve()
        # T3's updater replaces versioned files; look again in the same folder.
        found = sorted((p for p in path.parent.glob('T3-Code*.AppImage') if p.is_file()), key=version_key)
        if found:
            return found[-1].resolve()
    found = [p for folder in SEARCH for p in (HOME / folder).glob('T3-Code*.AppImage') if p.is_file()]
    if not found:
        raise Stop('Could not find your T3 Code AppImage in ~/' + ', ~/'.join(SEARCH) + '.\n'
                   f'Point to it once with: {NAME} --appimage /path/to/T3-Code-....AppImage')
    return sorted(found, key=version_key)[-1].resolve()


def find_install(explicit=None):
    """The folder of the installed T3 Code on Windows."""
    def installed(path):
        return (path / 'resources/app.asar').is_file() and (path / 'resources/server.asar').is_file()
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not installed(path):
            raise Stop(f'No T3 Code install at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured and installed(Path(configured)):
        return Path(configured)
    found = [exe.parent for folder in SEARCH for exe in folder.glob('*/T3 Code*.exe') if installed(exe.parent)]
    if not found:
        raise Stop('Could not find your T3 Code install in ' + ' or '.join(map(str, SEARCH)) + '.\n'
                   f'Point to it once with: {NAME} --install-dir "C:\\path\\to\\T3 Code"')
    return max(found, key=lambda p: (p / 'resources/app.asar').stat().st_mtime)


def find_stock(explicit=None):
    return find_install(explicit) if WIN else find_appimage(explicit)


def stock_exe(folder):
    # An upgrade in place can leave the old channel's exe behind; the Nightly one wins.
    return min(folder.glob('T3 Code*.exe'), key=lambda p: ('Nightly' not in p.name, p.name))


def require_nightly(version):
    if 'nightly' not in version:
        raise NotNightly(f'This is T3 Code {version}. The patches target T3 Code Nightly; install Nightly and run again.')


def installed_version(folder):
    archive = Archive(folder / 'resources/app.asar')
    try:
        return json.loads(archive.read('package.json'))['version']
    finally:
        archive.close()


def running(image):
    out = subprocess.run(['tasklist', '/FI', f'IMAGENAME eq {image}', '/NH', '/FO', 'CSV'], capture_output=True,
                         text=True, errors='replace').stdout
    return image.lower() in out.lower()


def quit_t3(install):
    """Ask every T3 Code window (stock and customized share the exe name) to close, then force what is left."""
    images = [p.name for p in install.glob('T3 Code*.exe')]
    for image in images:
        subprocess.run(['taskkill', '/IM', image], capture_output=True)
    deadline = time.time() + 20
    while time.time() < deadline and any(map(running, images)):
        time.sleep(2)
    for image in images:
        subprocess.run(['taskkill', '/F', '/T', '/IM', image], capture_output=True)
    deadline = time.time() + 30
    while time.time() < deadline and any(map(running, images)):
        time.sleep(1)
    if any(map(running, images)):
        raise Stop('T3 Code would not quit, so its update was not installed.')


def version_numbers(version):
    return [int(n) for n in re.findall(r'\d+', version)]


def t3_download(install):
    """The update T3 downloaded but has not installed, as (installer, version, sha512), when it is newer than the install."""
    info = load(PENDING / 'update-info.json') or {}
    match = re.fullmatch(r'T3-Code-(.+)-x64\.exe', info.get('fileName', ''))
    installer = match and PENDING / info['fileName']
    if not installer or not installer.is_file():
        return None
    if version_numbers(match[1]) <= version_numbers(installed_version(install)):
        return None
    return installer, match[1], info.get('sha512')


def fetch_nightly(newest):
    """The newest Nightly on GitHub as (installer, version, sha512), downloaded once and checked against the sha512 its
    release publishes, when it is newer than the version given. T3 only checks for updates now and then."""
    try:
        with urllib.request.urlopen(RELEASES, timeout=30) as response:
            releases = json.load(response)
        for release in releases:
            version = release['tag_name'].lstrip('v')
            name = f'T3-Code-{version}-x64.exe'
            assets = {a['name']: a['browser_download_url'] for a in release['assets'] if a['state'] == 'uploaded' and a['size']}
            if '-nightly.' in version and name in assets and 'nightly.yml' in assets:
                break
        else:
            return None
        if version_numbers(version) <= version_numbers(newest):
            return None
        with urllib.request.urlopen(assets['nightly.yml'], timeout=30) as response:
            match = re.search(re.escape('url: ' + name) + r'\s+sha512: (\S+)', response.read().decode('utf-8'))
        if not match:
            say(f'    {version} on GitHub has no checksum for {name}; not using it.')
            return None
        path = DOWNLOADS / name
        if not path.is_file():
            say(f'    Downloading T3 Code {version} from GitHub...')
            shutil.rmtree(DOWNLOADS, ignore_errors=True)  # only ever the newest one
            DOWNLOADS.mkdir(parents=True)
            part = path.with_name(name + '.part')
            try:
                urllib.request.urlretrieve(assets[name], part)
                verify_download(part, match[1])
            except BaseException:
                part.unlink(missing_ok=True)
                raise
            os.replace(part, path)
        return path, version, match[1]
    except (OSError, ValueError, KeyError, Stop) as error:  # offline, GitHub limits, a bad download: T3's own download still works
        say(f'    Could not get the newest Nightly from GitHub: {error}')
        return None


def pending_update(install):
    """The newest update not installed yet: T3's own download, or a newer Nightly fetched from GitHub."""
    t3 = t3_download(install)
    return fetch_nightly(t3[1] if t3 else installed_version(install)) or t3


def verify_download(installer, sha512):
    digest = hashlib.sha512()
    with installer.open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    if base64.b64encode(digest.digest()).decode() != sha512:
        raise Stop(f'{installer} does not match the checksum T3 recorded for it; not using it.')


def extract_installer(installer, destination):
    """Unpack the app from a T3 Code installer: the NSIS exe carries it as $PLUGINSDIR/app-64.7z."""
    seven = shutil.which('7z') or Path(os.environ.get('ProgramFiles', 'C:/Program Files')) / '7-Zip/7z.exe'
    if not Path(seven).is_file():
        raise Stop('7-Zip is needed to build ahead from a downloaded update. Install it from https://www.7-zip.org.')
    outer = destination.parent / 'installer'
    run([str(seven), 'e', str(installer), '$PLUGINSDIR/app-64.7z', f'-o{outer}', '-y'], capture=True)
    run([str(seven), 'x', str(outer / 'app-64.7z'), f'-o{destination}', '-y'], capture=True)
    shutil.rmtree(outer, ignore_errors=True)
    if not all((destination / 'resources' / name).is_file() for name in LAYOUT):
        raise Stop(f'{installer} does not hold a T3 Code app where expected.')


def asar_hashes(folder):
    return {name: sha256(folder / 'resources' / name) for name in sorted(LAYOUT)}


def adopt_prebuilt(install):
    """Once the update a build was made ahead for is installed (by the tray or an install request), that build becomes current."""
    prebuilt = load(PREBUILT)
    if not prebuilt or prebuilt['version'] != installed_version(install):
        return
    PREBUILT.unlink()
    if Path(prebuilt['build']).is_dir() and prebuilt.pop('asars') == asar_hashes(install):
        save(STATE, {**prebuilt, 'stock': fingerprint(install)})
        say(f'    Using the build made ahead for {prebuilt["version"]}.')


def install_pending(install):
    """Do what the tray's "restart to install" does, without starting T3 Code afterwards."""
    pending = pending_update(install)
    if not pending:
        say('No newer T3 Code download is waiting.')
        return
    installer, version, sha512 = pending
    verify_download(installer, sha512)
    current = installed_version(install)
    step(f'Installing T3 Code {version} (was {current})...')
    quit_t3(install)
    # The flags T3's own updater passes; it adds --force-run only to start the app again, which the install request does itself.
    result = subprocess.run([str(installer), '--updated', '/S'], timeout=900)
    if result.returncode or installed_version(install) != version:
        raise Stop(f'The T3 Code {version} installer exited with {result.returncode}; the installed version is '
                   f'{installed_version(install)}.')
    say(f'    Installed {version}.')
    if installer.parent == DOWNLOADS:
        installer.unlink()  # T3 keeps its own download; ours is not needed once installed


def restart_t3(install):
    """What an install request ends with: T3 Code closed, then opened again on whatever the launcher picks now."""
    quit_t3(install)
    cmd_launch(argparse.Namespace(rest=[]))


def fingerprint(path):
    if WIN:
        # The updater replaces the asars in place; size and mtime of both tell it changed.
        stats = [(path / 'resources' / name).stat() for name in sorted(LAYOUT)]
        return {'path': str(path), 'files': [[s.st_size, s.st_mtime_ns] for s in stats]}
    stat = path.stat()
    return {'path': str(path), 'size': stat.st_size, 'mtime': stat.st_mtime_ns}


# --- Electron asar archives ---------------------------------------------------------

class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(stock_root):
    """Upstream's public cloud config from the stock web bundle, by name."""
    found = {}
    holder = next(name for name, prefixes in LAYOUT.items() if 'apps/server/dist' in prefixes)
    archive = Archive(stock_root / 'resources' / holder)
    try:
        for _, data in archive.scripts('apps/server/dist/client/'):
            for name in PUBLIC_CONFIG:
                if name in found:
                    continue
                match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
                if match:
                    found[name] = match.group(2).decode()
            if len(found) == len(PUBLIC_CONFIG):
                break
    finally:
        archive.close()
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config):
    """Write stock_path with its bundles (see LAYOUT) replaced by build's, then verify it."""
    prefixes = LAYOUT[Path(stock_path).name]
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        if 'apps/server/dist' in prefixes:
            node('apps/server/dist')['files']['client'] = {'files': {}}
        overlays = {}
        for prefix in prefixes:
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if required.startswith(tuple(prefixes)) and required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if key in overlays or key.startswith('apps/server/dist/client/'):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            for prefix, marker in MARKERS:
                if prefix.startswith(tuple(prefixes)) and not any(marker in data for _, data in patched.scripts(prefix)):
                    raise Stop(f'The rebuilt bundle under {prefix} is missing the stats bar.')
            # Connect needs the same public config as stock in every bundle that carries it.
            for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
                if not prefix.startswith(tuple(prefixes)):
                    continue
                def contents(archive):
                    return b''.join(data for key, data in archive.scripts(prefix)
                                    if prefix.endswith('client/') or '/client/' not in key)
                stock_data, patched_data = contents(stock), contents(patched)
                for key, value in config.items():
                    if value.encode() in stock_data and value.encode() not in patched_data:
                        raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')
        finally:
            patched.close()
    finally:
        stock.close()


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def ensure_node(log):
    """Use the system Node if it is new enough, else a private copy from nodejs.org."""
    system = shutil.which('node')
    if system and node_major(system) >= 24:
        return None
    if WIN:
        # shortcut: no private Node download on Windows; add one if system Node ever lags behind.
        raise Stop('Node 24 or newer is required. Install it (winget install OpenJS.NodeJS) and run again.')
    arch ={'x86_64': 'x64', 'aarch64': 'arm64'}.get(os.uname().machine)
    if not arch:
        raise Stop('Node 24 or newer is required. Install it and run again.')
    private = sorted((CACHE / 'node').glob(f'node-v24.*-linux-{arch}'), key=version_key)
    if private and node_major(str(private[-1] / 'bin/node')) >= 24:
        return private[-1] / 'bin'
    step('Downloading Node 24 (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    version = next(r['version'] for r in releases if r['version'].startswith('v24.') and f'linux-{arch}' in r['files'])
    name = f'node-{version}-linux-{arch}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + '.tar.xz')
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    extract_tar(archive, folder)
    archive.unlink()
    return folder / name / 'bin'


def build_env(node_bin):
