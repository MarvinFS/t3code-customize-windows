RETRY_AFTER = 6 * 3600


def cmd_build(args):
    """Build; an unattended run also remembers a failure (so the scheduler does not rebuild in a loop) and says so once."""
    try:
        do_build(args)
    except NotNightly as stop:
        if not args.unattended:
            raise
        say(str(stop))  # nothing to do and nothing to fix: no failure record, no notification
    except Stop as stop:
        if args.unattended:
            try:
                state = load(STATE, {})
                state['failed'] = {'stock': fingerprint(find_stock(args.appimage)), 'recipe': recipe_hash(), 'at': time.time()}
                save(STATE, state)
            except (Stop, OSError):
                pass  # no install to fingerprint: nothing to remember
            notify('T3 Code (Customized) could not rebuild', str(stop).strip().splitlines()[0])
        raise
    finally:
        if getattr(args, 'restart', False):
            restart_t3(find_stock(args.appimage))


def do_build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    appimage = find_stock(args.appimage)
    if args.appimage:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'appimage': str(appimage)})
    if args.publish:
        if args.publish != 'off' and not re.fullmatch(r'[\w.-]+/[\w.-]+', args.publish):
            raise Stop('--publish takes the owner/name of a GitHub repo, or off.')
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'publish': None if args.publish == 'off' else args.publish})
    say('T3 Code: ' + str(appimage))
    if WIN and INSTALL_REQUEST.exists():
        fresh = time.time() - INSTALL_REQUEST.stat().st_mtime < 600  # a request left behind must not quit T3 hours later
        INSTALL_REQUEST.unlink()  # one attempt per request, so a failing install never repeats every hour
        if fresh:
            args.restart = True  # cmd_build reopens T3 Code at the end, whatever happens in between
            install_pending(appimage)
    if WIN:
        adopt_prebuilt(appimage)
    state = load(STATE, {})
    recipe = recipe_hash()
    stock_print = fingerprint(appimage)
    if WIN:  # cheap, so a scheduled run on stable T3 Code stops here instead of copying the install first
        require_nightly(installed_version(appimage))
    failed = state.get('failed') or {}
    if (args.unattended and (failed.get('stock'), failed.get('recipe')) == (stock_print, recipe)
            and time.time() - failed.get('at', 0) < RETRY_AFTER):
        return  # this exact T3 Code and patch set just failed; retry when either changes or after a while
    # T3 downloads an update well before it is installed: build for that one ahead, so installing it later takes seconds.
    ahead = pending_update(appimage) if WIN and not args.resume else None
    prebuilt = load(PREBUILT, {})
    if ahead and (prebuilt.get('version'), prebuilt.get('recipe')) == (ahead[1], recipe) and Path(prebuilt['build']).is_dir():
        ahead = None  # already built ahead; the installed version may still need its own build below
    if (not ahead and not args.force and not args.resume and state.get('stock') == stock_print
            and state.get('recipe') == recipe and built_app()):
        install_launcher(appimage)
        say(f'\nAlready up to date. Open "{LAUNCHER_NAME}" from your app launcher.')
        return
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    shutil.rmtree(CACHE / 'work', ignore_errors=True)  # what an earlier failed run left behind; the lock means no one is using it
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w', encoding='utf-8', errors='replace') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        if ahead:
            say(f'    Building ahead for the downloaded {ahead[1]}; the installed T3 Code is not touched.')
            verify_download(ahead[0], ahead[2])
            stock_root = job / 'app'
            extract_installer(ahead[0], stock_root)
        elif WIN:
            # Work on a copy: the updater may replace the installed files at any time.
            stock_root = job / 'app'
            shutil.copytree(appimage, stock_root)
            if fingerprint(appimage) != stock_print:
                raise Stop('T3 Code was updated while it was being read. Run again.')
        else:
            run([str(appimage), '--appimage-extract'], cwd=job, log=log)
            stock_root = job / 'squashfs-root'
        archive = Archive(stock_root / 'resources/app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
        finally:
            archive.close()
        config = read_public_config(stock_root)
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        require_nightly(version)
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This AppImage does not record its source commit, so it cannot be rebuilt exactly.')
        say(f'    Nightly {version}, upstream commit {commit[:12]}')
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        node_bin = ensure_node(log)
        env = build_env(node_bin)
        target = ensure_commit(commit, version, log)
        step('Applying the patches...')
        attempts = 2
        resume = ported = args.resume
        agent = None
        while True:
            try:
                prepare(target, log, resume=resume)
                install_dependencies(env, log)
                if not args.skip_checks:
                    checks(env, log)
                break
            except NeedsFix as problem:
                if older_than_patches(target):
                    raise Stop(stuck_message(problem, target))
                say(str(problem))
                agent = agent or choose_agent(args.fix)
                if not agent or attempts == 0:
                    raise NeedsFix(stuck_message(problem, target))
                attempts -= 1
                agent_fix(agent, str(problem), target, version, log)
                resume = ported = True
        head = git('rev-parse', 'HEAD').strip()
        build_bundles(env, version, stock_root, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        step('Assembling and verifying your customized app...')
        source = asar_hashes(stock_root) if ahead else None  # what the installer will put in place, matched on adopt
        for name in LAYOUT:
            output = job / name
            overlay(stock_root / 'resources' / name, output, SOURCE, config)
            shutil.move(str(output), stock_root / 'resources' / name)
        if ported:
            export_patches(target)
        destination = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(stock_root), destination)
        if not WIN:  # Windows finds the build through state.json; symlinks need privileges there
            link = DATA / 'current.new'
            if link.is_symlink():
                link.unlink()
            link.symlink_to(destination.relative_to(DATA))
            os.replace(link, CURRENT)
        record = {'stock': stock_print, 'version': version, 'commit': target, 'recipe': recipe_hash(),
                  'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG),
                  'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')}
        if ahead:
            save(PREBUILT, {**record, 'asars': source})
        else:
            save(STATE, record)
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
        repo = load(CONFIG / 'config.json', {}).get('publish')
        if repo and WIN and not publish(destination, version, target, repo) and args.unattended:
            notify('T3 Code (Customized) could not publish', f'The build for {version} is fine. See unattended.log.')
    shutil.rmtree(job, ignore_errors=True)
    install_launcher(appimage)
    minutes = max(1, round((time.time() - started) / 60))
    if ahead:
        say(f'\nDone in {minutes} min: built ahead for T3 Code {version}. Install it from the T3 Code tray ("restart to install"); the next run then switches to this build.')
        if args.unattended:
            notify(f'T3 Code {version} is ready', 'Install it from the T3 Code tray; the next run then switches to this build.')
        if ported:
            say(f'The ported patches were saved to {REPO / "patches"}.')
        return
    say(f'\nDone in {minutes} min: T3 Code {version} with the stats bar.')
    if args.unattended:
        notify('T3 Code (Customized) is ready', f'Rebuilt for {version}. Quit T3 Code and open "{LAUNCHER_NAME}".')
    if ported:
        say(f'The ported patches were saved to {REPO / "patches"}.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say(f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        say('First time? Turn on Settings > General > Stats for nerds.')


def export_patches(target):
    """Keep a port that an agent or you finished, so the next build starts from it."""
    out = REPO / 'patches'
    for path in patches():
        path.unlink()
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..HEAD', capture=False)
    (out / 'base.txt').write_text(target + '\n', encoding='utf-8', newline='\n')


def prune():
    """Keep the current build, the one made ahead and the one before the current, which a running instance may still use."""
    keep = ({Path(b).resolve() for b in (load(STATE, {}).get('build'), load(PREBUILT, {}).get('build')) if b} if WIN
            else {CURRENT.resolve()})
    # By the build time that ends each name: a folder's mtime is the copied install's or the installer archive's.
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.name[-15:], reverse=True)
    current = Path(load(STATE, {}).get('build') or (builds[0] if builds else ''))
    keep.add(current.resolve())
    previous = next((b for b in builds if b.resolve() not in keep and b.name[-15:] < current.name[-15:]), None)
    for old in builds:
        if old.resolve() not in keep and old != previous:
            shutil.rmtree(old, ignore_errors=True)


def cmd_verify(args):
    """Apply the patches to their base and run the checks. No AppImage needed (used by CI)."""
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    base = (REPO / 'patches/base.txt').read_text(encoding='utf-8').strip()
    with (logs / ('verify-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w', encoding='utf-8', errors='replace') as log:
        say('Log: ' + log.name)
        env = build_env(ensure_node(log))
        target = ensure_commit(base, None, log)
        prepare(target, log)
        install_dependencies(env, log)
        checks(env, log)
    say('Patches apply and pass their checks on ' + base[:12] + '.')


def built_app():
    """The customized build's executable (AppRun on Linux), or None before the first build."""
    if WIN:
        build = load(STATE, {}).get('build')
        return stock_exe(Path(build)) if build and Path(build).is_dir() else None
    built = CURRENT / 'AppRun'
    return built if built.exists() else None


def launch_target():
    """The customized build if it was made from the AppImage installed right now, else stock."""
    appimage = find_stock()
    state = load(STATE, {})
    built = built_app()
    if DISABLED.exists() or not built:
        return appimage, None
    if state.get('stock') != fingerprint(appimage):
        return appimage, f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    return built.resolve(), None


def cmd_launch(args):
    try:  # the Windows shortcut runs without a console, so a failure must surface as a notification
        appimage = find_stock()
        target, notice = launch_target()
    except Stop as stop:
        notify('T3 Code (Customized)', str(stop))
        raise
    if notice:
        say(notice)
        notify('Opening stock T3 Code', notice)
    if WIN:
        exe = stock_exe(appimage) if target == appimage else target
        # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP: T3 Code outlives this launcher.
        subprocess.Popen([str(exe), *args.rest], cwd=exe.parent, close_fds=True, creationflags=0x00000008 | 0x00000200)
        return
    if target != appimage:
        # Run the extracted copy as if it were the AppImage, so T3's own updater still updates the real file.
        os.environ['APPIMAGE'] = str(appimage)
        os.environ['APPDIR'] = str(target.parent)
    os.execv(str(target), [str(target), *args.rest])


def cmd_status(args):
    appimage = find_stock()
    state = load(STATE, {})
    target, notice = launch_target()
    say('Installed T3 Code:  ' + str(appimage))
    say('Customized build:   ' + (f"{state['version']} (built {state['builtAt']})" if state else 'none yet'))
    say('Switched:           ' + ('off' if DISABLED.exists() else 'on'))
    say('Next launch opens:  ' + ('customized build' if target != appimage else 'stock T3 Code'))
    if WIN:
        task = powershell('(Get-ScheduledTask -TaskName $env:T3C_TASK -ErrorAction SilentlyContinue).State', task=TASK)
        say('Automatic rebuild:  ' + (f'on ({task.stdout.strip()})' if task.stdout.strip() else f'off (run {NAME} schedule)'))
    if notice:
        say(notice)


def cmd_on(args):
    DISABLED.unlink(missing_ok=True)
    say('Customization on. Quit T3 Code fully and reopen it.')


def cmd_off(args):
    DATA.mkdir(parents=True, exist_ok=True)
    DISABLED.touch()
    say('Stock T3 Code on the next launch. Quit it fully and reopen it.')


def make_pack(build, version, commit):
    """Zip the two asars of a build, to extract over a T3 Code of the same version by hand. Keeps the newest two zips."""
    PACKS.mkdir(parents=True, exist_ok=True)
    pack = PACKS / f'{NAME}-{version}.zip'
    with zipfile.ZipFile(pack, 'w', zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for name in LAYOUT:
            archive.write(build / 'resources' / name, 'resources/' + name)
        archive.comment = f'{version} {commit}'.encode()
    for old in sorted(PACKS.glob('*.zip'), key=lambda p: p.stat().st_mtime, reverse=True)[2:]:
        old.unlink()  # the current and the previous zip are all that is kept
    return pack


def cmd_pack(args):
    if not WIN:
        raise Stop('pack is for the Windows build. A Linux build is one app.asar inside the AppImage.')
    state = load(STATE, {})
    if not state.get('build') or not Path(state['build']).is_dir():
        raise Stop(f'There is no customized build yet. Run {NAME} first.')
    pack = make_pack(Path(state['build']), state['version'], state['commit'])
    say(f"{pack} ({pack.stat().st_size >> 20} MB)")
    say(f"It fits T3 Code {state['version']} only. Quit T3 Code fully, extract it into the folder that holds the T3 Code exe "
        'and let it overwrite resources\\app.asar and resources\\server.asar.')


RELEASE_TAG = re.compile(r'v\d+\.\d+\.\d+-nightly\.(\d+)\.(\d+)')


def publish(build, version, commit, repo):
    """Upload the build's zip as a GitHub release of repo, keep only it and the newest other of our releases, and mark the
    newest nightly as Latest. Anything that goes wrong is reported and never fails the build; nothing is deleted unless the
    upload worked."""
    try:
        gh = shutil.which('gh')
        if not gh:
            raise Stop('the GitHub CLI (gh) is not installed')
        env = dict(os.environ)  # the account that owns the repo, whichever one gh has active right now
        token = subprocess.run([gh, 'auth', 'token', '--user', repo.split('/')[0]], capture_output=True, text=True)
        if token.returncode == 0 and token.stdout.strip():
            env['GH_TOKEN'] = token.stdout.strip()

        def run(*args):
            result = subprocess.run([gh, *args, '--repo', repo], capture_output=True, text=True, env=env)
            if result.returncode:
                raise Stop(f'gh {" ".join(args[:2])} failed: {(result.stderr or result.stdout).strip()}')
            return result.stdout

        pack = make_pack(build, version, commit)
        tag = 'v' + version
        notes = (f'The two patched files for T3 Code Nightly {version} (upstream commit {commit[:12]}). It fits only that nightly.\n\n'
                 '1. Quit T3 Code fully, including its tray icon.\n'
                 '2. Extract the zip into the T3 Code folder, the one that holds `T3 Code (Nightly).exe`, and let it overwrite '
                 '`resources\\app.asar` and `resources\\server.asar`.\n'
                 '3. Open T3 Code and turn on Settings > General > Stats for nerds.\n\n'
                 f'SHA-256 of the zip: {sha256(pack)}\n')
        if subprocess.run([gh, 'release', 'view', tag, '--repo', repo], capture_output=True, env=env).returncode == 0:
            run('release', 'upload', tag, str(pack), '--clobber')
        else:
            run('release', 'create', tag, str(pack), '--title', f'T3 Code Nightly {version}', '--notes', notes)
        releases = json.loads(run('release', 'list', '--limit', '100', '--json', 'tagName'))
        # Newest nightly first, by its date and build number: GitHub's createdAt is the date of the tagged commit.
        ours = sorted((r['tagName'] for r in releases if RELEASE_TAG.fullmatch(r['tagName'])),
                      key=lambda tag: tuple(map(int, RELEASE_TAG.fullmatch(tag).groups())), reverse=True)
        keep = [tag] + [t for t in ours if t != tag][:1]  # this build, even a rebuild of an older nightly, and the newest other
        old = [t for t in ours if t not in keep]
        for stale in old:
            run('release', 'delete', stale, '--cleanup-tag', '--yes')
        run('release', 'edit', ours[0], '--latest')  # otherwise GitHub badges whichever release was created last
        say(f'    Published {tag} to {repo}' + (f' and removed {len(old)} older' if old else '') + '.')
        return True
    except (Stop, OSError, ValueError, KeyError) as problem:
        say(f'    Could not publish to {repo}: {problem}')
        return False


# Rebuild automatically: at sign-in and every hour, which costs nothing while T3 Code and the patches are unchanged.
SCHEDULE = r'''
$action = New-ScheduledTaskAction -Execute $env:T3C_EXE -Argument $env:T3C_ARGS -WorkingDirectory $env:T3C_DIR
$trigger = @((New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME),
             (New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 60) -RepetitionDuration (New-TimeSpan -Days 3650)))
$settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
    -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Hours 2)
Register-ScheduledTask -TaskName $env:T3C_TASK -Action $action -Trigger $trigger -Settings $settings -Force | Out-Null
'''


def cmd_schedule(args):
    if not WIN:
        raise Stop('Automatic rebuilds are set up with a Windows scheduled task; on Linux, run it from cron or a systemd timer.')
    gui = Path(sys.executable).with_name('pythonw.exe')
    result = powershell(SCHEDULE, task=TASK, exe=gui if gui.exists() else sys.executable,
                        args=f'"{REPO / NAME}" build --unattended', dir=REPO)
    if result.returncode:
        raise Stop('Could not register the scheduled task:\n' + result.stderr)
    say(f'Scheduled task "{TASK}": rebuilds at sign-in and every hour when T3 Code, a downloaded update or the patches changed.')
    say(f'Progress is in {CACHE / "unattended.log"}; run {NAME} status to see the task.')


def cmd_unschedule(args):
    if WIN:
        powershell('Unregister-ScheduledTask -TaskName $env:T3C_TASK -Confirm:$false -ErrorAction SilentlyContinue', task=TASK)
    say('Automatic rebuilds are off.')


def cmd_uninstall(args):
    if WIN:
        cmd_unschedule(args)
        BIN.unlink(missing_ok=True)
    elif BIN.is_symlink() and BIN.resolve() == (REPO / NAME).resolve():
        BIN.unlink()
    DESKTOP.unlink(missing_ok=True)
    for folder in (DATA, CACHE, CONFIG):
        shutil.rmtree(folder, ignore_errors=True)
    tail = '' if DATA in REPO.parents else f' You can delete {REPO} too.'
    say('Removed t3code-customize, its launcher, builds and caches. Your T3 Code and its data are untouched.' + tail)


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog='With no command, it updates the patches and builds for your installed T3 Code.')
    sub = parser.add_subparsers(dest='command')

    def build_options(p):
        p.add_argument('--appimage', '--install-dir', dest='appimage', help='path to your T3 Code AppImage, or its install folder on Windows (remembered)')
        p.add_argument('--unattended', action='store_true', help='for the scheduled task: log to a file, notify, never prompt, do not retry a failure for 6 hours')
        p.add_argument('--fix', choices=sorted(AGENTS), help='if a nightly breaks the patches, let this agent port them without asking')
        p.add_argument('--resume', action='store_true', help='continue from the source checkout as you or your agent left it')
        p.add_argument('--skip-checks', action='store_true', help='skip the patch tests and typechecks')
        p.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
        p.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')
        p.add_argument('--publish', metavar='OWNER/REPO', help='after each build, upload its two asars as a release of this GitHub repo and keep the newest two releases (remembered; "off" stops)')

    build_options(sub.add_parser('build', help='update the patches and build (the default)'))
    launch = sub.add_parser('launch', help='open the customized build if it matches your T3 Code, else stock')
    launch.add_argument('rest', nargs=argparse.REMAINDER)
    sub.add_parser('status', help='show what the next launch opens')
    sub.add_parser('on', help='use the customized build')
    sub.add_parser('off', help='go back to stock T3 Code')
    sub.add_parser('pack', help='zip the two patched asars of the current build, to extract over T3 Code by hand (Windows)')
    sub.add_parser('verify', help='apply the patches to their base and run the checks (for CI)')
    sub.add_parser('schedule', help='rebuild automatically after T3 Code updates (Windows scheduled task)')
    sub.add_parser('unschedule', help='stop the automatic rebuilds')
    sub.add_parser('uninstall', help='remove the launcher, builds and caches')
    if WIN and sys.stdout:
        sys.stdout.reconfigure(encoding='utf-8', errors='replace')
    argv = sys.argv[1:]
    if not argv or argv[0].startswith('-') and argv[0] not in ('-h', '--help'):
        argv = ['build', *argv]
    args = parser.parse_args(argv)
    handler = globals()['cmd_' + args.command]
    if args.command in ('launch', 'status', 'on', 'off', 'schedule', 'unschedule'):
        return handler(args)
    CACHE.mkdir(parents=True, exist_ok=True)
    global LOCK
    with (CACHE / 'lock').open('w') as lock:
        LOCK = lock
        try:
            if WIN:
                msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
            else:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Stop(f'Another {NAME} is already running.')
        if getattr(args, 'unattended', False):
            # No console under the scheduler: keep what this run says in a log, trimmed when it grows.
            journal = CACHE / 'unattended.log'
            sys.stdout = sys.stderr = journal.open('w' if journal.exists() and journal.stat().st_size > 1 << 20 else 'a',
                                                   encoding='utf-8', buffering=1)
        handler(args)


if __name__ == '__main__':
    try:
        main()
    except Stop as stop:
        print(f'\n{stop}', file=sys.stderr)
        sys.exit(3 if isinstance(stop, NeedsFix) else 1)
    except KeyboardInterrupt:
        print('\nStopped. Your T3 Code is untouched.', file=sys.stderr)
        sys.exit(130)
