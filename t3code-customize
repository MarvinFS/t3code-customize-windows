def take_upstream_patches(follow, env):
    """A copy with commits of its own keeps its script and docs; upstream's patches and checks.json replace the ones here.
    Recorded as a merge that keeps this side's files, so the copy counts as up to date and upstream edits to the script never conflict."""
    def git_(*args):
        return subprocess.run(['git', *args], cwd=REPO, env=env, capture_output=True, text=True, encoding='utf-8')
    base = git_('merge-base', 'HEAD', follow).stdout.strip()
    if not base:
        raise Stop(f'{REPO} and upstream ({follow}) share no history, so their patches cannot be compared.')
    gone = git_('diff', '--name-only', '--no-renames', '--diff-filter=D', base, follow, '--', 'patches', 'checks.json')
    if gone.returncode:
        raise Stop(f'Could not compare {REPO} with upstream:\n{gone.stderr.strip()}')
    for command in [('merge', '-s', 'ours', '--no-commit', '--quiet', follow), ('checkout', follow, '--', 'patches', 'checks.json'),
                    *[('rm', '-q', '--ignore-unmatch', '--', name) for name in gone.stdout.split()],  # patches upstream dropped or renamed
                    ('commit', '--no-edit', '--quiet')]:
        result = git_(*command)
        if result.returncode:
            git_('merge', '--abort')
            raise Stop(f'Could not take the latest patches into {REPO} (git {command[0]} failed):\n{(result.stderr or result.stdout).strip()}')
    step('Took upstream\'s newer patches; this copy\'s own script and docs were kept.')


def pull_latest():
    """Bring this repo up to date: a plain clone fast-forwards, a copy with commits of its own takes upstream's patches.
    Any local port of the patches is kept in a backup."""
    if not (REPO / '.git').exists():
        return
    status = subprocess.run(['git', 'status', '--porcelain', '--', 'patches', 'checks.json'],
                            cwd=REPO, capture_output=True, text=True).stdout
    before = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    # A private copy keeps btsouth's repo as the remote 'upstream' and follows its main; a plain clone follows its own upstream.
    remotes = subprocess.run(['git', 'remote'], cwd=REPO, capture_output=True, text=True).stdout.split()
    follow = 'upstream/main' if 'upstream' in remotes else '@{u}'
    if subprocess.run(['git', 'fetch', '--quiet', *(['upstream'] if 'upstream' in remotes else [])], cwd=REPO,
                      stderr=subprocess.DEVNULL).returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    behind = subprocess.run(['git', 'rev-list', '--count', 'HEAD..' + follow], cwd=REPO, capture_output=True, text=True).stdout.strip()
    if behind in ('', '0'):
        return
    if status.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches', 'checks.json'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    env = {**os.environ, **GIT_ENV}
    if subprocess.run(['git', 'merge', '--ff-only', '--quiet', follow], cwd=REPO, env=env, stderr=subprocess.DEVNULL).returncode:
        take_upstream_patches(follow, env)  # not a fast-forward: this copy has commits of its own
    after = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if after != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        argv = [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull']
        if WIN:  # os.execv on Windows returns to the shell before the child finishes
            msvcrt.locking(LOCK.fileno(), msvcrt.LK_UNLCK, 1)  # the child takes the lock itself; Windows locks are not shared with it
            sys.exit(subprocess.run(argv).returncode)
        os.execv(sys.executable, argv)


