+              { name: "ENABLE_TOOL_SEARCH", value: "", sensitive: false },
+            ],
+            enabled: true,
+            config: DEFAULT_CLAUDE_SETTINGS,
+          },
+          {},
+        ).pipe(Effect.map((adapter) => [adapter])),
+      );
+    }).pipe(Effect.orDie, Effect.provide(NodeServices.layer)),
   ).pipe(
     Layer.provide(
       Layer.mergeAll(
