+/** A skill load stays readable at a glance, like the Claude Code CLI shows it. */
+function SkillTimelineRow({ row }: { row: Extract<TimelineRow, { kind: "skill" }> }) {
+  const status = SKILL_ROW_STATUS[row.status];
+  return (
+    <div className="mx-auto w-full max-w-(--chat-content-max-width) py-1 text-sm">
+      <div className="flex min-w-0 items-center gap-1.5 text-foreground">
+        <span className="flex shrink-0 [&_svg]:size-3.5">
+          <SkillChipIcon />
+        </span>
+        <span className="shrink-0 font-medium">Skill({row.name})</span>
