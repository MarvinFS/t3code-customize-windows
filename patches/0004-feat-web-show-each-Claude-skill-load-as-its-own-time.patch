+      </div>
+      <div
+        className={`flex items-center gap-1.5 pl-1.5 text-xs ${
+          row.status === "failed" ? "text-destructive" : "text-muted-foreground"
+        }`}
+      >
+        <span aria-hidden="true">└</span>
+        <span
+          ref={row.status === "running" ? observeVisibleAnimation : undefined}
