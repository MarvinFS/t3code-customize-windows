+import { EnvironmentId, type RtkSavings } from "@t3tools/contracts";
+import { renderToStaticMarkup } from "react-dom/server";
+import { beforeEach, describe, expect, it, vi } from "vite-plus/test";
+
+import { ComposerStats, RtkSavingsChip } from "./ComposerStats";
+
+// Only the data boundary is stubbed; the component under test is the real one.
+const rtk = vi.hoisted(() => ({ savings: null as RtkSavings | null }));
+vi.mock("~/state/rtkSavings", () => ({ useRtkSavings: () => rtk.savings }));
+
+const savings: RtkSavings = {
+  date: "2026-10-28",
+  commands: 39,
+  savedTokens: 1_380,
+  savingsPercent: 12.2,
+  totalSavedTokens: 2_159_103,
+};
+
+describe("RtkSavingsChip", () => {
+  it("shows today's saved tokens and percentage the way the CLI status line does", () => {
+    const text = renderToStaticMarkup(<RtkSavingsChip savings={savings} />).replace(/<[^>]*>/g, "");
+    expect(text).toContain("RTK");
+    expect(text).toContain("-1.4k");
+    expect(text).toContain("(12%)");
+  });
+
+  it("takes the free space between the limit meters and the turn stats and centers in it", () => {
+    const markup = renderToStaticMarkup(<RtkSavingsChip savings={savings} />);
+    expect(markup).toMatch(/^<span class="[^"]*\bflex-1\b[^"]*\bjustify-center\b/);
+  });
+});
+
+describe("ComposerStats with RTK savings", () => {
+  const noStats = {
+    context: null,
+    turn: null,
