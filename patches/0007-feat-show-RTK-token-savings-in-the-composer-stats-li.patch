@@ -0,0 +1,73 @@
+import type { RtkSavings } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+/**
+ * The part of `rtk gain --daily --format json` that is read here; RTK prints more. Only the
+ * daily list is required, because RTK versions differ on the summary and the all-time total is
+ * only a detail in the stats line's tooltip.
+ */
+const RtkGainReport = Schema.Struct({
+  summary: Schema.optional(Schema.Struct({ total_saved: Schema.optional(Schema.Number) })),
+  daily: Schema.Array(
+    Schema.Struct({
+      date: Schema.String,
+      commands: Schema.Number,
+      saved_tokens: Schema.Number,
+      savings_pct: Schema.Number,
+    }),
+  ),
+});
+
+const decodeGainReport = Schema.decodeUnknownOption(Schema.fromJsonString(RtkGainReport));
+
+/**
+ * Today's entry from RTK's daily report. Null when RTK printed something else, has no
+ * entry for today or saved nothing, which is when the CLI status line shows no RTK part.
+ */
+export function parseRtkGain(output: string, today: string): RtkSavings | null {
+  const report = Option.getOrNull(decodeGainReport(output));
+  const day = report?.daily.find((entry) => entry.date === today);
+  if (report === null || day === undefined) return null;
+  const savedTokens = Math.round(day.saved_tokens);
+  if (savedTokens <= 0) return null;
+  const totalSaved = report.summary?.total_saved;
+  return {
+    date: day.date,
+    commands: Math.max(0, Math.round(day.commands)),
+    savedTokens,
+    savingsPercent: Math.min(100, Math.max(0, day.savings_pct)),
+    ...(totalSaved === undefined
+      ? {}
+      : { totalSavedTokens: Math.max(savedTokens, Math.round(totalSaved)) }),
+  };
+}
+
+/** RTK files its days by local calendar date, as the CLI status line does. */
+export function localIsoDate(now: DateTime.Utc, zone: DateTime.TimeZone): string {
+  return DateTime.formatIsoDate(DateTime.setZone(now, zone));
+}
+
+/**
+ * Reads what RTK saved today on this host. RTK is optional, so every failure (not
+ * installed, slow, unreadable) reads as null and the stats line simply omits it.
+ */
+export const read = Effect.fn("RtkSavings.read")(function* () {
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const output = yield* spawner
+    .string(
+      ChildProcess.make("rtk", ["gain", "--daily", "--format", "json"], {
+        stdin: "ignore",
+        stderr: "ignore",
+      }),
+    )
+    .pipe(
+      Effect.timeout("5 seconds"),
+      Effect.orElseSucceed(() => ""),
+    );
+  const now = yield* DateTime.now;
+  return parseRtkGain(output, localIsoDate(now, DateTime.zoneMakeLocal()));
+});
