diff --git a/apps/web/src/state/rtkSavings.ts b/apps/web/src/state/rtkSavings.ts
new file mode 100644
index 0000000000..5ee95cbcee
--- /dev/null
+++ b/apps/web/src/state/rtkSavings.ts
@@ -0,0 +1,30 @@
+import {
+  createEnvironmentRpcQueryAtomFamily,
+  selectEnvironmentQueryData,
+} from "@t3tools/client-runtime/state/runtime";
+import { WS_METHODS, type EnvironmentId, type RtkSavings } from "@t3tools/contracts";
+
+import { connectionAtomRuntime } from "../connection/runtime";
+import { useEnvironmentQuerySelector } from "./query";
+
+const REFRESH_MS = 60_000;
+
+/** RTK's savings on an environment's host, re-read once a minute for as long as a stats line keeps the query alive. */
+const rtkSavingsAtom = createEnvironmentRpcQueryAtomFamily(connectionAtomRuntime, {
+  label: "environment-data:server:rtk-savings",
+  tag: WS_METHODS.serverGetRtkSavings,
+  staleTimeMs: REFRESH_MS,
+  refreshIntervalMs: REFRESH_MS,
+});
+
+/**
+ * Null until a value arrives (still loading, or the request failed, as it does on a server
+ * that predates the RPC) and when the host has no RTK or saved nothing today. The stats line
+ * shows no RTK part then. Polling rebuilds unchanged results, so only the data is selected.
+ */
+export function useRtkSavings(environmentId: EnvironmentId): RtkSavings | null {
+  return useEnvironmentQuerySelector(
+    rtkSavingsAtom({ environmentId, input: {} }),
+    selectEnvironmentQueryData,
+  );
+}
