--- /dev/null
+++ b/apps/server/src/rtk/RtkSavings.test.ts
@@ -0,0 +1,199 @@
+import { describe, expect, it } from "@effect/vitest";
+import { RtkSavings as RtkSavingsSchema } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as PlatformError from "effect/PlatformError";
+import * as Schema from "effect/Schema";
+import * as Sink from "effect/Sink";
+import * as Stream from "effect/Stream";
+import * as TestClock from "effect/testing/TestClock";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+import * as RtkSavings from "./RtkSavings.ts";
+
+const encoder = new TextEncoder();
+const isRtkSavings = Schema.is(RtkSavingsSchema);
+
+/** The part of `rtk gain --daily --format json` that matters here; RTK prints more. */
+const gainOutput = (daily: ReadonlyArray<Record<string, unknown>>, totalSaved = 2_159_103) =>
+  JSON.stringify({
+    summary: { total_commands: 28_008, total_saved: totalSaved, avg_savings_pct: 25.06 },
+    daily,
+  });
+
+const todayEntry = {
+  date: "2026-10-28",
+  commands: 39,
+  input_tokens: 11_293,
+  output_tokens: 9_913,
+  saved_tokens: 1_380,
+  savings_pct: 12.219959266802444,
+};
+
+describe("parseRtkGain", () => {
+  it("returns today's entry with the all-time total", () => {
+    const yesterday = { ...todayEntry, date: "2026-10-27", saved_tokens: 4_106 };
+    expect(RtkSavings.parseRtkGain(gainOutput([yesterday, todayEntry]), "2026-10-28")).toEqual({
+      date: "2026-10-28",
+      commands: 39,
+      savedTokens: 1_380,
+      savingsPercent: 12.219959266802444,
+      totalSavedTokens: 2_159_103,
+    });
+  });
+
+  it("keeps today's entry when the report has no summary to take an all-time total from", () => {
+    const output = JSON.stringify({ daily: [todayEntry] });
+    expect(RtkSavings.parseRtkGain(output, "2026-10-28")).toEqual({
+      date: "2026-10-28",
+      commands: 39,
+      savedTokens: 1_380,
+      savingsPercent: 12.219959266802444,
+    });
+  });
+
+  it("is null when RTK has no entry for today", () => {
+    const output = gainOutput([{ ...todayEntry, date: "2026-10-27" }]);
+    expect(RtkSavings.parseRtkGain(output, "2026-10-28")).toBeNull();
+  });
+
+  it("is null when nothing was saved today, like the CLI status line", () => {
+    const output = gainOutput([{ ...todayEntry, saved_tokens: 0, savings_pct: 0 }]);
+    expect(RtkSavings.parseRtkGain(output, "2026-10-28")).toBeNull();
+  });
+
+  it.each([
+    ["empty output", ""],
+    ["a shell error", "rtk: command not found"],
+    ["a report without days", JSON.stringify({ summary: { total_saved: 1 } })],
+    ["a malformed day list", JSON.stringify({ summary: { total_saved: 1 }, daily: 5 })],
+  ])("is null for %s", (_name, output) => {
+    expect(RtkSavings.parseRtkGain(output, "2026-10-28")).toBeNull();
+  });
+
+  it("keeps its result inside what the contract accepts", () => {
+    const output = gainOutput([{ ...todayEntry, saved_tokens: 1_380.4, savings_pct: 100.4 }]);
+    const parsed = RtkSavings.parseRtkGain(output, "2026-10-28");
+    expect(parsed).toMatchObject({ savedTokens: 1_380, savingsPercent: 100 });
+    expect(isRtkSavings(parsed)).toBe(true);
+  });
+
+  it("is null when a fractional count rounds down to nothing", () => {
+    const output = gainOutput([{ ...todayEntry, saved_tokens: 0.4 }]);
+    expect(RtkSavings.parseRtkGain(output, "2026-10-28")).toBeNull();
+  });
+});
+
+describe("localIsoDate", () => {
+  const instant = DateTime.makeUnsafe("2026-10-28T22:30:00Z");
+
+  it("names the calendar day in the given zone, not in UTC", () => {
+    expect(RtkSavings.localIsoDate(instant, DateTime.zoneMakeNamedUnsafe("Europe/Bucharest"))).toBe(
+      "2026-10-29",
+    );
+    expect(
+      RtkSavings.localIsoDate(instant, DateTime.zoneMakeNamedUnsafe("America/Los_Angeles")),
+    ).toBe("2026-10-28");
+  });
+});
+
+interface SpawnCall {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+}
+
+const layerSpawner = (
+  respond: (call: SpawnCall) => Effect.Effect<string, PlatformError.PlatformError>,
+  calls: Array<SpawnCall> = [],
+) =>
+  Layer.succeed(
+    ChildProcessSpawner.ChildProcessSpawner,
+    ChildProcessSpawner.make((command) =>
+      Effect.gen(function* () {
+        if (!ChildProcess.isStandardCommand(command)) {
+          return yield* Effect.die("Expected a standard command.");
+        }
+        const call = { command: command.command, args: command.args };
+        calls.push(call);
+        const stdout = yield* respond(call);
+        return ChildProcessSpawner.makeHandle({
+          pid: ChildProcessSpawner.ProcessId(1),
+          exitCode: Effect.succeed(ChildProcessSpawner.ExitCode(0)),
+          isRunning: Effect.succeed(false),
+          kill: () => Effect.void,
+          unref: Effect.succeed(Effect.void),
+          stdin: Sink.drain,
+          stdout: Stream.make(encoder.encode(stdout)),
+          stderr: Stream.empty,
+          all: Stream.empty,
+          getInputFd: () => Sink.drain,
+          getOutputFd: () => Stream.empty,
+        });
+      }),
+    ),
+  );
+
+const noon = DateTime.makeUnsafe("2026-10-28T12:00:00Z");
+const localToday = RtkSavings.localIsoDate(noon, DateTime.zoneMakeLocal());
+
+describe("RtkSavings.read", () => {
+  it.effect("runs rtk gain for daily JSON and returns today's savings", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(DateTime.toEpochMillis(noon));
+      const calls: Array<SpawnCall> = [];
+      const savings = yield* RtkSavings.read().pipe(
+        Effect.provide(
+          layerSpawner(
+            () => Effect.succeed(gainOutput([{ ...todayEntry, date: localToday }])),
+            calls,
+          ),
+        ),
+      );
+      expect(calls).toEqual([{ command: "rtk", args: ["gain", "--daily", "--format", "json"] }]);
+      expect(savings).toMatchObject({ date: localToday, savedTokens: 1_380, commands: 39 });
+    }),
+  );
+
+  it.effect("is null when rtk is not installed", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(DateTime.toEpochMillis(noon));
+      const savings = yield* RtkSavings.read().pipe(
+        Effect.provide(
+          layerSpawner(() =>
+            PlatformError.systemError({
+              _tag: "NotFound",
+              module: "ChildProcess",
+              method: "spawn",
+              description: "rtk is not on PATH",
+            }),
+          ),
+        ),
+      );
+      expect(savings).toBeNull();
+    }),
+  );
+
+  it.effect("is null when rtk prints something unreadable", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(DateTime.toEpochMillis(noon));
+      const savings = yield* RtkSavings.read().pipe(
+        Effect.provide(layerSpawner(() => Effect.succeed("not json at all"))),
+      );
+      expect(savings).toBeNull();
+    }),
+  );
+
+  it.effect("gives up on an rtk that never answers", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(DateTime.toEpochMillis(noon));
+      const fiber = yield* RtkSavings.read().pipe(
+        Effect.provide(layerSpawner(() => Effect.never)),
+        Effect.forkChild,
+      );
+      yield* TestClock.adjust("5 seconds");
+      expect(yield* Fiber.join(fiber)).toBeNull();
+    }),
+  );
+});
