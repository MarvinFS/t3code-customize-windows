+describe("formatRtkPercent", () => {
+  it("rounds to a whole percent", () => {
+    expect(formatRtkPercent(12.2)).toBe("12%");
+    expect(formatRtkPercent(0.4)).toBe("0%");
+    expect(formatRtkPercent(99.6)).toBe("100%");
