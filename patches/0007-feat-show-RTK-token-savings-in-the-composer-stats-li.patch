+  it("spells out today's figures and the all-time total", () => {
+    expect(formatRtkSavingsDetail(savings)).toBe(
+      "RTK removed 13,527 tokens (38.8%) from 87 command outputs today. All time: 2,171,279 tokens. This counts every agent session on this host, not just this thread.",
+    );
