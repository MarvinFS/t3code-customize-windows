@@ -0,0 +1,34 @@
+import * as Schema from "effect/Schema";
+import { describe, expect, it } from "vite-plus/test";
+
+import { RtkSavings } from "./rtkSavings.ts";
+
+const decodeRtkSavings = Schema.decodeSync(RtkSavings);
+
+const sample = {
+  date: "2026-10-28",
+  commands: 39,
+  savedTokens: 1380,
+  savingsPercent: 12.2,
+  totalSavedTokens: 2_159_103,
+};
+
+describe("RtkSavings", () => {
+  it("decodes one day of savings", () => {
+    expect(decodeRtkSavings(sample)).toEqual(sample);
+  });
+
+  it("decodes savings without an all-time total", () => {
+    const { totalSavedTokens: _total, ...withoutTotal } = sample;
+    expect(decodeRtkSavings(withoutTotal)).toEqual(withoutTotal);
+  });
+
+  it.each([
+    ["negative saved tokens", { ...sample, savedTokens: -1 }],
+    ["fractional saved tokens", { ...sample, savedTokens: 1.5 }],
+    ["a percentage above 100", { ...sample, savingsPercent: 100.5 }],
+    ["a blank date", { ...sample, date: " " }],
+  ])("rejects %s", (_name, value) => {
+    expect(() => decodeRtkSavings(value)).toThrow();
+  });
+});
diff --git a/packages/contracts/src/rtkSavings.ts b/packages/contracts/src/rtkSavings.ts
new file mode 100644
index 0000000000..31a2b6bfca
--- /dev/null
+++ b/packages/contracts/src/rtkSavings.ts
@@ -0,0 +1,19 @@
+import * as Schema from "effect/Schema";
+
+import { NonNegativeInt, TrimmedNonEmptyString } from "./baseSchemas.ts";
+
+/**
+ * What RTK, the local CLI output compressor, saved on the server host today.
+ * The server reads it from `rtk gain`, so it covers every agent session on that host.
+ */
+export const RtkSavings = Schema.Struct({
+  /** Host-local calendar day the figures belong to, as YYYY-MM-DD. */
+  date: TrimmedNonEmptyString,
+  commands: NonNegativeInt,
+  savedTokens: NonNegativeInt,
+  /** Share of the day's raw output tokens that RTK removed. */
+  savingsPercent: Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 100 })),
+  /** Everything RTK has saved on this host since it began recording; absent when RTK does not report it. */
+  totalSavedTokens: Schema.optional(NonNegativeInt),
+});
+export type RtkSavings = typeof RtkSavings.Type;
