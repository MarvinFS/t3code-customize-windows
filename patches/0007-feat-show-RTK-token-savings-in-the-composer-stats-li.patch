+/**
+ * RTK's saved-token count as the CLI status line prints it: one decimal of thousands,
+ * with millions taking over before a value would round up to 1000.0k.
+ */
+export function formatRtkSavedTokens(tokens: number): string {
+  if (tokens < 1_000) return String(tokens);
+  const thousands = Math.round(tokens / 100) / 10;
+  if (thousands < 1_000) return `${thousands.toFixed(1)}k`;
+  return `${(Math.round(tokens / 100_000) / 10).toFixed(1)}M`;
+}
+
+export function formatRtkPercent(percent: number): string {
+  return `${Math.round(percent)}%`;
+}
+
+/** The chip's hover text: today's figures, the all-time total when RTK reports one, and the scope. */
+export function formatRtkSavingsDetail(savings: RtkSavings): string {
+  const count = (value: number) => value.toLocaleString("en-US");
+  const allTime =
+    savings.totalSavedTokens === undefined
+      ? ""
+      : ` All time: ${count(savings.totalSavedTokens)} tokens.`;
+  return `RTK removed ${count(savings.savedTokens)} tokens (${savings.savingsPercent.toFixed(1)}%) from ${count(savings.commands)} command outputs today.${allTime} This counts every agent session on this host, not just this thread.`;
+}
